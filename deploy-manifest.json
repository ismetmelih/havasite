{
  "version": 1,
  "framework": { "name": "node-http", "version": "1.0.0" },
  "routes": [
    {
      "path": "/api/*",
      "target": { "kind": "Compute", "src": "default" }
    },
    {
      "path": "/*.*",
      "target": { "kind": "Static", "cacheControl": "public, max-age=60" },
      "fallback": { "kind": "Compute", "src": "default" }
    },
    {
      "path": "/*",
      "target": { "kind": "Compute", "src": "default" }
    }
  ],
  "computeResources": [
    {
      "name": "default",
      "runtime": "nodejs22.x",
      "entrypoint": "server.js"
    }
  ]
}
