{
  "expo": {
    "name": "TürkiyeCanlı",
    "slug": "turkiyecanli",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "turkiyecanli",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.turkiyecanli.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Hava durumunu ve depremlerin sana uzaklığını göstermek için konumunu kullanırız. Konumun cihazında kalır."
      }
    },
    "android": {
      "package": "com.turkiyecanli.app",
      "adaptiveIcon": {
        "backgroundColor": "#0d0f13",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#0d0f13"
        }
      ],
      "expo-image",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Hava durumunu ve depremlerin sana uzaklığını göstermek için konumunu kullanırız. Konumun cihazında kalır."
        }
      ],
      "expo-audio",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "backgroundColor": "#0d0f13"
  }
}
